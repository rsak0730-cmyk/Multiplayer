<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>oghost-agent</UserSecretsId>
    <AssemblyName>OGHost.Agent</AssemblyName>
    <RootNamespace>OGHost.Agent</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The unit tests exercise internal members (e.g. BdsVersionDiscovery.ParsePage)
       so page-layout changes are caught by CI instead of shipping broken. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OGHost.Agent.Tests" />
  </ItemGroup>

</Project>
