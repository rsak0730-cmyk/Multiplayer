# OG HOST web — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. NEVER commit real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: server-side only (API routes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of this deployment (used in pairing instructions / emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- BDS version discovery ---
# Optional override for the official BDS download page. Defaults to the
# official Minecraft Bedrock server download page.
BDS_DOWNLOAD_PAGE_URL=https://www.minecraft.net/en-us/download/server/bedrock

# --- Rate limiting (optional; in-memory by default) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
