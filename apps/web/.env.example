# OG HOST web — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. NEVER commit real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: server-side only (API routes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of this deployment (used in pairing instructions / emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- BDS version discovery ---
# Optional override for the official BDS download page. Defaults to the
# official Minecraft Bedrock server download page.
BDS_DOWNLOAD_PAGE_URL=https://www.minecraft.net/en-us/download/server/bedrock

# --- Rate limiting (optional; in-memory by default) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- OG VOICE (optional) ---
# Voice chat needs a self-hosted LiveKit server running on a machine you
# control — NOT on Vercel, and not a paid managed service. Until these three
# are set, voice reports "not configured" and everything else keeps working:
# Minecraft hosting does not depend on the voice server.
#
# Generate the key/secret pair in your LiveKit server's config.yml
# (keys: - key: ... / secret: ...). The secret signs room tokens and must never
# reach the browser, the Android app or the Windows companion; those receive a
# short-lived per-session token minted here instead.
#
# LIVEKIT_URL must be wss:// for anything a phone has to reach. Plain ws:// is
# accepted only for localhost, because audio would otherwise travel unencrypted.
LIVEKIT_URL=wss://voice.your-domain.example
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional. How long a minted voice token stays valid, in seconds.
# Default 3600; allowed range 60–86400. The companion refreshes in the
# background, so a shorter value costs the player nothing and bounds the damage
# if a token is ever captured.
VOICE_TOKEN_TTL_SECONDS=3600
